{
  "name": "pi-workflow",
  "version": "0.1.0",
  "type": "module",
  "description": "Strict single-file Edit IR tools for Pi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacek4yang/pi-workflow.git"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "check": "tsc --noEmit && tsx --test test/*.test.ts",
    "test": "tsx --test test/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "pi-codebuffer": "git+https://github.com/jacek4yang/pi-codebuffer.git"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typebox": "1.3.27",
    "prettier": "^3.9.9"
  }
}
